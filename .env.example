# Backend environment variables.
# Copy to `.env` at the repo root and fill in real values. `.env` is gitignored.
# Frontend vars live separately in `frontend/.env.local` (see frontend/.env.local.example).

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# Comma-separated origins allowed to call the API (the Next.js dev server).
CORS_ORIGINS=http://localhost:3000

# --- Supabase ---
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Secret (server-side only) key — never expose to the browser.
SUPABASE_SECRET_KEY=
# Publishable key — safe for the browser, sent in the `apikey` header.
SUPABASE_PUBLISHABLE_KEY=
# JWKS endpoint used to verify user tokens. The new sb_* keys sign JWTs
# asymmetrically, so verification fetches public keys from here rather than
# sharing a symmetric secret.
SUPABASE_JWKS_URL=

# Postgres connection string.
# Use the SESSION POOLER string, not the direct `db.<ref>.supabase.co` host:
# the direct host is IPv6-only. Username is `postgres.<project-ref>`.
# Percent-encode special characters in the password (`#` -> %23, `@` -> %40).
DATABASE_URL=

# --- Gemini ---
# Get a key from https://aistudio.google.com/apikey — the free tier is enough
# to run the agent, subject to per-minute and per-day request limits.
GEMINI_API_KEY=
# Verify the id against `client.models.list()`; model names change.
GEMINI_MODEL=gemini-3.6-flash

# --- Market data ---
# yfinance is the primary provider and needs no key.
# Alpha Vantage is the documented fallback (free tier: 25 requests/day).
ALPHA_VANTAGE_API_KEY=

# --- News ---
NEWSAPI_API_KEY=
