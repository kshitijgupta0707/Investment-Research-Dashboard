# Frontend environment variables.
# Copy to `frontend/.env.local` and fill in. `.env.local` is gitignored.
#
# Only NEXT_PUBLIC_* values belong here — they are inlined into the browser
# bundle. Never put a secret key or the Gemini key in this file; all LLM calls
# go through the FastAPI backend.

# FastAPI backend base URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase project URL and publishable key (both are browser-safe by design).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
